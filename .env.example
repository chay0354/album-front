# Backend URL (no trailing slash). Leave empty for local dev (Vite proxy).
# Production / Vercel: set to your backend origin, e.g. https://album-back.vercel.app
VITE_API_URL=

# Supabase project URL (for public storage URLs: covers, album-photos).
# From Supabase Dashboard → Settings → API → Project URL
VITE_SUPABASE_URL=
# Anon (public) key — needed for large-album PDF upload via signed Storage URL (bypasses Vercel 4.5MB limit).
# Dashboard → Settings → API → anon public
VITE_SUPABASE_ANON_KEY=
